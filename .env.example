# Copy to .env and fill in keys you have. All providers are optional —
# local Claude Code / Gemini CLI logs work with no keys.

# ── Anthropic / Claude ──────────────────────────────────────────
# Admin key (sk-ant-admin01-...) for Console usage + cost reports
ANTHROPIC_ADMIN_KEY=
# Optional: also used for OAuth subscription quota (Claude Code / claude.ai)
# Usually auto-read from ~/.claude/.credentials.json

# ── OpenAI Platform API (pay-as-you-go) ─────────────────────────
# Admin / org key required for /v1/organization/usage and /costs
OPENAI_ADMIN_KEY=
# Fallback: regular API key (limited billing endpoints)
OPENAI_API_KEY=

# ── Codex (ChatGPT Free/Plus/Pro) ───────────────────────────────
# No env vars needed. Auto-reads ~/.codex/sessions + ~/.codex/auth.json
# CODEX_HOME=~/.codex

# ── Grok Build (X Premium / SuperGrok) + xAI API ────────────────
# Grok Build: auto-reads ~/.grok/logs/unified.jsonl + sessions
# GROK_HOME=~/.grok
# Optional separate developer API (pay-as-you-go, not X Premium):
XAI_API_KEY=
# Management key (console.x.ai → Settings → Management Keys)
XAI_MANAGEMENT_KEY=
XAI_TEAM_ID=

# ── Cursor ──────────────────────────────────────────────────────
# Team Admin API key (Enterprise): cursor.com/dashboard → API Keys
CURSOR_API_KEY=
# Personal dashboard session cookie (WorkosCursorSessionToken)
# From browser cookies on cursor.com while logged in
CURSOR_SESSION_TOKEN=

# ── Google Gemini ───────────────────────────────────────────────
# AI Studio / Generative Language API key (rate-limit tier info)
GEMINI_API_KEY=
# Optional: Google Cloud project for Cloud Billing export (advanced)
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# ── OpenRouter ──────────────────────────────────────────────────
# openrouter.ai/keys — pay-as-you-go credit/spend info
OPENROUTER_API_KEY=

# ── App ─────────────────────────────────────────────────────────
LLM_USAGE_DAYS=30
LLM_USAGE_PORT=8765
